{
  "app": {
    "name": "墨魂·江湖 AI 文字 MUD 世界模拟器",
    "description": "基于 Dify 的复杂中文文字角色扮演游戏引擎，三角色并行架构（世界推演/天道/原著校验）",
    "mode": "chatflow",
    "icon": "🎭",
    "icon_background": "#1a1a2e"
  },
  "conversation_variables": [
    {"name": "novel_name", "value_type": "string", "default": "", "description": "本局游戏小说名"},
    {"name": "game_phase", "value_type": "string", "default": "not_started", "description": "游戏阶段：not_started / initializing / choosing_identity / playing / ended"},
    {"name": "player_state", "value_type": "string", "default": "{}", "description": "完整玩家状态 JSON（属性/战斗/生存/武功/物品/关系/天道/威胁/任务）"},
    {"name": "world_time", "value_type": "string", "default": "{\"年\":\"\",\"月\":\"\",\"日\":1,\"时辰\":\"辰时\"}", "description": "当前世界时间"},
    {"name": "round_count", "value_type": "number", "default": 0, "description": "当前游戏轮次（用于伪随机种子）"},
    {"name": "game_log", "value_type": "string", "default": "[]", "description": "最近20轮游戏摘要（解决长对话遗忘）"},
    {"name": "dataset_id", "value_type": "string", "default": "", "description": "本局小说知识库 ID"},
    {"name": "display_mode", "value_type": "string", "default": "simple", "description": "显示模式：simple(简略) / verbose(详细)"},
    {"name": "last_tool_log", "value_type": "string", "default": "", "description": "上一轮工具调用执行日志（供 /验算 展示）"}
  ],
  "workflow": {
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "position": {"x": 100, "y": 400},
        "variables": [
          {"name": "user_input", "value_type": "string", "required": true}
        ]
      },
      {
        "id": "intent_classifier",
        "type": "code",
        "position": {"x": 320, "y": 400},
        "title": "意图分类器",
        "code_file": "../code-nodes/intent_classifier.py",
        "inputs": {
          "user_input": "{{#start.user_input#}}",
          "game_phase": "{{#game_phase#}}",
          "novel_name": "{{#novel_name#}}"
        },
        "outputs": ["intent", "novel_name_extracted", "response"]
      },
      {
        "id": "intent_router",
        "type": "condition",
        "position": {"x": 540, "y": 400},
        "title": "意图路由",
        "cases": [
          {"id": "case_init", "conditions": [{"variable": "{{#intent_classifier.intent#}}", "operator": "is", "value": "init_game"}]},
          {"id": "case_switch", "conditions": [{"variable": "{{#intent_classifier.intent#}}", "operator": "is", "value": "switch_novel"}]},
          {"id": "case_save", "conditions": [{"variable": "{{#intent_classifier.intent#}}", "operator": "is", "value": "save"}]},
          {"id": "case_load", "conditions": [{"variable": "{{#intent_classifier.intent#}}", "operator": "is", "value": "load"}]},
          {"id": "case_query", "conditions": [{"variable": "{{#intent_classifier.intent#}}", "operator": "is", "value": "query"}]},
          {"id": "case_verbose", "conditions": [{"variable": "{{#intent_classifier.intent#}}", "operator": "is", "value": "verbose"}]},
          {"id": "case_simple", "conditions": [{"variable": "{{#intent_classifier.intent#}}", "operator": "is", "value": "simple"}]},
          {"id": "case_action", "conditions": [{"variable": "{{#intent_classifier.intent#}}", "operator": "is", "value": "game_action"}]}
        ]
      },

      {"id": "llm_init_world", "type": "llm", "position": {"x": 800, "y": 100}, "title": "世界初始化 LLM",
        "model": {"provider": "deepseek", "name": "deepseek-chat", "temperature": 0.9, "max_tokens": 4096},
        "system_prompt": "你是【墨魂·江湖】世界初始化引擎。基于小说《{{#intent_classifier.novel_name_extracted#}}》生成：1）世界观简述 2）时间线起点 3）主要势力格局 4）4个可选开局身份（最后一个为自定义）。每个身份标注：身份名称与背景、初始时间点、初始位置、优势与劣势、初始必做任务预览。",
        "user_prompt": "请基于小说《{{#intent_classifier.novel_name_extracted#}}》开始世界初始化。"
      },
      {"id": "var_init_assigner", "type": "variable-assigner", "position": {"x": 1080, "y": 100}, "title": "写入初始变量",
        "assignments": [
          {"variable": "novel_name", "value": "{{#intent_classifier.novel_name_extracted#}}"},
          {"variable": "game_phase", "value": "choosing_identity"}
        ]
      },
      {"id": "init_answer", "type": "answer", "position": {"x": 1360, "y": 100}, "title": "输出开局",
        "answer": "{{#llm_init_world.text#}}"
      },

      {"id": "save_answer", "type": "answer", "position": {"x": 800, "y": 220}, "title": "存档输出",
        "answer": "【存档】\n小说：《{{#novel_name#}}》\n轮次：{{#round_count#}}\n\n请保存以下 JSON：\n```json\n{\"novel_name\":\"{{#novel_name#}}\",\"player_state\":{{#player_state#}},\"world_time\":{{#world_time#}},\"round_count\":{{#round_count#}},\"game_log\":{{#game_log#}}}\n```"
      },
      {"id": "query_answer", "type": "answer", "position": {"x": 800, "y": 320}, "title": "查询指令输出",
        "answer": "【查询结果】\n当前小说：《{{#novel_name#}}》\n游戏阶段：{{#game_phase#}}\n轮次：{{#round_count#}}\n\n完整状态：\n```json\n{{#player_state#}}\n```"
      },

      {"id": "kb_retrieval", "type": "knowledge-retrieval", "position": {"x": 800, "y": 480}, "title": "知识库检索（小说原文）",
        "dataset_id": "{{#dataset_id#}}",
        "query": "{{#start.user_input#}}",
        "top_k": 6,
        "retrieval_mode": "hybrid"
      },

      {"id": "llm_world", "type": "llm", "position": {"x": 1100, "y": 380}, "title": "A·世界推演引擎",
        "model": {"provider": "deepseek", "name": "deepseek-chat", "temperature": 0.3, "max_tokens": 2048},
        "system_prompt_file": "../prompts/world_engine.md",
        "system_prompt_vars": {
          "novel_name": "{{#novel_name#}}",
          "round_count": "{{#round_count#}}",
          "world_time": "{{#world_time#}}",
          "player_location": "{{#player_state#}}",
          "player_state": "{{#player_state#}}",
          "recent_summary": "{{#game_log#}}"
        },
        "user_prompt": "玩家本轮行动：{{#start.user_input#}}\n\n请列出需要调用的本角色工具（roll_d20/roll_dice/calc_damage/calc_survival_cost/calc_travel/update_state），输出 JSON 数组。"
      },

      {"id": "llm_heavenly", "type": "llm", "position": {"x": 1100, "y": 560}, "title": "C·天道守护者",
        "model": {"provider": "deepseek", "name": "deepseek-chat", "temperature": 0.4, "max_tokens": 2048},
        "system_prompt_file": "../prompts/heavenly_will.md",
        "system_prompt_vars": {
          "novel_name": "{{#novel_name#}}",
          "round_count": "{{#round_count#}}",
          "world_time": "{{#world_time#}}",
          "user_action": "{{#start.user_input#}}",
          "tiandao_state": "{{#player_state#}}",
          "player_state": "{{#player_state#}}",
          "recent_summary": "{{#game_log#}}"
        },
        "user_prompt": "请基于玩家本轮行动判定天道变化，列出需要调用的本角色工具（calc_tiandao/calc_breakthrough/calc_relationship/generate_threat/calc_reward），输出 JSON 数组。"
      },

      {"id": "llm_canon", "type": "llm", "position": {"x": 1100, "y": 740}, "title": "B·原著守门人",
        "model": {"provider": "deepseek", "name": "deepseek-chat", "temperature": 0.3, "max_tokens": 2048},
        "system_prompt_file": "../prompts/canon_keeper.md",
        "system_prompt_vars": {
          "novel_name": "{{#novel_name#}}",
          "round_count": "{{#round_count#}}",
          "world_time": "{{#world_time#}}",
          "player_location": "{{#player_state#}}",
          "user_action": "{{#start.user_input#}}",
          "npcs_involved": "（由 LLM 自行从玩家行动中识别）",
          "items_involved": "（由 LLM 自行从玩家行动中识别）",
          "canon_fragments": "{{#kb_retrieval.result#}}",
          "has_nitian": "{{#player_state#}}",
          "recent_summary": "{{#game_log#}}"
        },
        "user_prompt": "请基于玩家本轮行动 + 检索到的原著片段，执行六项校验和 NPC 应然状态查询，列出需要调用的本角色工具（update_character_state/check_canon/check_npc_persona/calc_cultivation/calc_shop/check_character_state_change），输出 JSON 数组 + 一行校验结论。"
      },

      {"id": "merge_results", "type": "code", "position": {"x": 1420, "y": 560}, "title": "三路工具合并执行",
        "code_file": "../code-nodes/merge_results.py",
        "inputs": {
          "world_calls": "{{#llm_world.text#}}",
          "heavenly_calls": "{{#llm_heavenly.text#}}",
          "canon_calls": "{{#llm_canon.text#}}",
          "player_state": "{{#player_state#}}",
          "world_time": "{{#world_time#}}",
          "round_count": "{{#round_count#}}"
        },
        "outputs": ["world_tool_results", "heavenly_tool_results", "canon_tool_results", "all_tool_results", "tool_count", "exec_log", "merged_state_changes"]
      },

      {"id": "llm_narrator", "type": "llm", "position": {"x": 1720, "y": 560}, "title": "叙事合并 LLM",
        "model": {"provider": "deepseek", "name": "deepseek-chat", "temperature": 0.85, "max_tokens": 6144},
        "system_prompt_file": "../prompts/system_prompt.md",
        "system_prompt_vars": {
          "novel_name": "{{#novel_name#}}",
          "round_count": "{{#round_count#}}",
          "world_time": "{{#world_time#}}",
          "user_action": "{{#start.user_input#}}",
          "player_state": "{{#player_state#}}",
          "recent_summary": "{{#game_log#}}",
          "world_tool_results": "{{#merge_results.world_tool_results#}}",
          "heavenly_tool_results": "{{#merge_results.heavenly_tool_results#}}",
          "canon_tool_results": "{{#merge_results.canon_tool_results#}}"
        },
        "user_prompt": "玩家本轮行动：{{#start.user_input#}}\n\n请基于三路工具执行结果，生成完整的 10 模块输出。叙事中的所有数值必须与工具 RESULT 一致。"
      },

      {"id": "state_updater", "type": "code", "position": {"x": 2020, "y": 560}, "title": "状态更新",
        "code_file": "../code-nodes/state_parser.py",
        "inputs": {
          "llm_output": "{{#llm_narrator.text#}}",
          "player_state": "{{#player_state#}}",
          "world_time": "{{#world_time#}}",
          "game_log": "{{#game_log#}}",
          "round_count": "{{#round_count#}}"
        },
        "outputs": ["new_player_state", "new_world_time", "new_game_log", "new_round_count", "parse_error"]
      },

      {"id": "var_assigner", "type": "variable-assigner", "position": {"x": 2300, "y": 560}, "title": "写入会话变量",
        "assignments": [
          {"variable": "player_state", "value": "{{#state_updater.new_player_state#}}"},
          {"variable": "world_time", "value": "{{#state_updater.new_world_time#}}"},
          {"variable": "game_log", "value": "{{#state_updater.new_game_log#}}"},
          {"variable": "round_count", "value": "{{#state_updater.new_round_count#}}"},
          {"variable": "last_tool_log", "value": "{{#merge_results.exec_log#}}"}
        ]
      },

      {"id": "answer", "type": "answer", "position": {"x": 2580, "y": 560}, "title": "输出",
        "answer": "{{#llm_narrator.text#}}"
      }
    ],
    "edges": [
      {"source": "start", "target": "intent_classifier"},
      {"source": "intent_classifier", "target": "intent_router"},

      {"source": "intent_router", "target": "llm_init_world", "case_id": "case_init"},
      {"source": "intent_router", "target": "llm_init_world", "case_id": "case_switch"},
      {"source": "intent_router", "target": "save_answer", "case_id": "case_save"},
      {"source": "intent_router", "target": "query_answer", "case_id": "case_query"},
      {"source": "intent_router", "target": "query_answer", "case_id": "case_verbose"},
      {"source": "intent_router", "target": "query_answer", "case_id": "case_simple"},

      {"source": "llm_init_world", "target": "var_init_assigner"},
      {"source": "var_init_assigner", "target": "init_answer"},

      {"source": "intent_router", "target": "kb_retrieval", "case_id": "case_action"},

      {"source": "kb_retrieval", "target": "llm_world"},
      {"source": "kb_retrieval", "target": "llm_heavenly"},
      {"source": "kb_retrieval", "target": "llm_canon"},

      {"source": "llm_world", "target": "merge_results"},
      {"source": "llm_heavenly", "target": "merge_results"},
      {"source": "llm_canon", "target": "merge_results"},

      {"source": "merge_results", "target": "llm_narrator"},
      {"source": "llm_narrator", "target": "state_updater"},
      {"source": "state_updater", "target": "var_assigner"},
      {"source": "var_assigner", "target": "answer"}
    ]
  }
}
